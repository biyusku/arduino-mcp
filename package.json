{
  "name": "arduino-mcp",
  "version": "4.0.0",
  "description": "MCP server for Arduino via arduino-cli — compile, upload, monitor and wire up any board (Uno, Mega, Nano, ESP32, ESP8266, RP2040) from an AI assistant",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "arduino-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arduino",
    "esp32",
    "esp32-s3",
    "arduino-cli",
    "iot",
    "embedded",
    "rp2040",
    "serial-monitor",
    "claude"
  ],
  "author": "birusk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biyusku/arduino-mcp.git"
  },
  "homepage": "https://github.com/biyusku/arduino-mcp#readme",
  "bugs": {
    "url": "https://github.com/biyusku/arduino-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "serialport": "^13.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
