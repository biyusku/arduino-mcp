{
  "name": "arduino-mcp",
  "version": "3.3.0",
  "description": "Universal MCP server for Arduino IDE & arduino-cli — compile, upload, monitor any board (ESP32, Uno, Mega, RP2040) via AI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "arduino-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arduino",
    "esp32",
    "esp32-s3",
    "arduino-cli",
    "iot",
    "embedded",
    "rp2040",
    "serial-monitor",
    "claude"
  ],
  "author": "birusk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/birusk/arduino-mcp.git"
  },
  "homepage": "https://github.com/birusk/arduino-mcp#readme",
  "bugs": {
    "url": "https://github.com/birusk/arduino-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}